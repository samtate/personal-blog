---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  socialImage,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage ?? '/favicon.svg', Astro.site);
const defaultStructuredData = title === SITE_TITLE
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: canonical.origin,
    }
  : undefined;
const jsonLd = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {pageType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {pageType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    )}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('samtate-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${SITE_TITLE} home`}>
          <span aria-hidden="true">&gt;</span>{SITE_TITLE}<span class="cursor" aria-hidden="true"></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/"><span aria-hidden="true">01.</span> writing</a>
          <a href="/about/"><span aria-hidden="true">02.</span> about</a>
          <button class="theme-toggle" type="button" aria-label="Switch to light mode">
            <span aria-hidden="true">[</span><span data-theme-label>dark</span><span aria-hidden="true">]</span>
          </button>
        </nav>
      </header>
      <div class="system-strip" aria-hidden="true">
        <span class="online-state"><i></i> online</span>
        <span>render: static</span>
        <span>content: markdown</span>
        <span data-local-clock>--:--:-- Europe/London</span>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Built with Astro. No tracking.</p>
      <a href="#main">Back to top ↑</a>
    </footer>
    <script is:inline>
      const prefetched = new Set();
      const prefetchPage = (anchor) => {
        if (!(anchor instanceof HTMLAnchorElement)) return;
        const url = new URL(anchor.href);
        if (url.origin !== window.location.origin || url.pathname === window.location.pathname) return;
        if (prefetched.has(url.href)) return;
        prefetched.add(url.href);
        const hint = document.createElement('link');
        hint.rel = 'prefetch';
        hint.href = url.href;
        document.head.appendChild(hint);
      };
      document.querySelectorAll('a[href]').forEach((anchor) => {
        anchor.addEventListener('pointerenter', () => prefetchPage(anchor), { once: true });
        anchor.addEventListener('focus', () => prefetchPage(anchor), { once: true });
      });

      const toggle = document.querySelector('.theme-toggle');
      const label = toggle?.querySelector('[data-theme-label]');

      const syncThemeControl = () => {
        const theme = document.documentElement.dataset.theme ?? 'dark';
        if (label) label.textContent = theme;
        toggle?.setAttribute(
          'aria-label',
          `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`,
        );
      };

      syncThemeControl();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('samtate-theme', next);
        syncThemeControl();
      });

      const clock = document.querySelector('[data-local-clock]');
      const clockFormat = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/London',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      const updateClock = () => {
        if (clock) clock.textContent = `${clockFormat.format(new Date())} Europe/London`;
      };
      updateClock();
      setInterval(updateClock, 1000);
    </script>
  </body>
</html>
